<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>$APP_ID</id>
    <metadata_license>MIT</metadata_license>
    <project_license>Apache-2.0 and GPL-3.0-or-later</project_license>

    <name>$APP_NAME</name>
    <summary>The fast, native code editor that doesn't get in your way</summary>
    <developer id="me.farshed">
        <name translate="no">Farshed</name>
    </developer>
    <description>
        <p>
            Wu is a code editor for people who want the speed of a native app and the familiarity of VS Code. Built on the Zed engine, it keeps the editor core, GPU rendering, and language tooling, then strips out everything that isn't editing.
        </p>
        <p>Features:</p>
        <ul>
            <li>Performance: Written in Rust and rendered on the GPU. No Electron or webviews. Opens instantly and stays responsive on large files.</li>
            <li>Language-aware: Maintains a syntax tree for precise highlighting and auto-indent, with LSP support for autocompletion and refactoring.</li>
            <li>Lightweight: Uses noticeably less memory than comparable editors.</li>
            <li>Familiar: Layout, panels, and defaults are tuned so VS Code users don't have to relearn their editor.</li>
        </ul>
    </description>

    <launchable type="desktop-id">$APP_ID.desktop</launchable>

    <branding>
        <color type="primary" scheme_preference="light">$BRANDING_LIGHT</color>
        <color type="primary" scheme_preference="dark">$BRANDING_DARK</color>
    </branding>

    <content_rating type="oars-1.1" />

    <url type="homepage">https://wu.farshed.me</url>
    <url type="bugtracker">https://github.com/farshed/wu/issues</url>
    <url type="help">https://wu.farshed.me/docs</url>
    <url type="contact">https://github.com/farshed/wu/issues</url>
    <url type="vcs-browser">https://github.com/farshed/wu</url>

    <supports>
        <internet>offline-only</internet>
    </supports>
    <recommends>
        <control>pointing</control>
        <control>keyboard</control>
        <display_length compare="ge">768</display_length>
    </recommends>

    <screenshots>
        <screenshot type="default">
            <caption>Wu with a project open, in the Catppuccin Mocha theme</caption>
            <image>https://raw.githubusercontent.com/farshed/wu/main/assets/images/screenshot-dark.png</image>
        </screenshot>
        <screenshot>
            <caption>Wu with a project open, in the Catppuccin Latte theme</caption>
            <image>https://raw.githubusercontent.com/farshed/wu/main/assets/images/screenshot-light.png</image>
        </screenshot>
    </screenshots>

    <releases>
		@release_info@
		<release version="0.0.0" date="1970-01-01">
			<description>
				<p>Dummy release to keep flatpak-builder AppStream metadata validation from complaining</p>
			</description>
		</release>
    </releases>
</component>
